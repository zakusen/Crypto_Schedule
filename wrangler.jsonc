{
  // CRYPTO SIGNAL ARCHIVE（Cloudflare Worker）
  // public/ を公開し、/api/* だけ worker.js が答える。売買botのリポジトリとは完全に別物。
  "name": "signal-archive",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
